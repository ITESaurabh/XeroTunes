# Generated by scripts/linux/aur.sh in github.com/ITESaurabh/XeroTunes on every
# release; edits made on the AUR are overwritten.
pkgname=@PKGNAME@
pkgver=@PKGVER@
_tag=@TAG@
pkgrel=1
pkgdesc='An open source cross platform music player application'
arch=('x86_64')
url='https://xerotunes.com'
license=('GPL-3.0-only')
depends=(@DEPENDS@)
provides=("${pkgname%-bin}")
conflicts=("${pkgname%-bin}")
options=('!strip' '!debug')
source=("$pkgname-$pkgver.deb::https://github.com/ITESaurabh/XeroTunes/releases/download/$_tag/@DEB@")
sha256sums=('@SHA256@')

package() {
  bsdtar -xf data.tar.* -C "$pkgdir"
  rm -rf "$pkgdir/usr/share/lintian"
}
